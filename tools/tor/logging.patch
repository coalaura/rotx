 } logfile_t;
 
+static log_callback rotx_log_callback;
+
+/* The embedding host sets this only before tor_run_main and after it returns.
+ * Attach it to each console handler so log reconfiguration preserves it.
+ * File and signal-safe logging retain their original destinations. */
+void
+rotx_tor_set_log_callback(log_callback callback)
+{
+  rotx_log_callback = callback;
+}
